.DS_Store
__pycache__/
*.pyc
.env
# Ignore all fetched/generated data, but keep data/README.md (regeneration guide).
# Must be `data/*` not `data/`, otherwise git can't re-include a file under it.
data/*
!data/README.md
# dashboard/data.js is committed so the dashboard works from a fresh clone
# (data/ contents are ignored, so they can't be regenerated after cloning)
