# cached data in data/raw/. dashboard/replay.html (the multi-race picker shell) IS
# committed, since it's a small asset-driven page that works from a clone.
dashboard/replay_*.html
dashboard/replays/

# Local Claude Code settings (worktrees, per-machine overrides)
.claude/settings.local.json
.claude/worktrees/
